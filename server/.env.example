# Reference only: the server reads process environment variables, not this file.
APP_ENV=dev
HTTP_ADDR=:8081
DATABASE_URL=postgres://postgres@127.0.0.1:5432/online_exam?sslmode=disable
# Required in release mode; leave empty in dev to use the built-in dev secret.
JWT_SECRET=
JWT_TTL=8h
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
LOG_LEVEL=info
MAX_BODY_BYTES=1048576
# Used only by `go run ./cmd/seed` when creating the initial admin account.
SEED_ADMIN_PASSWORD=Admin@123456
